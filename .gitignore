# Build artifacts / disk images
*.iso
*.qcow2
*.raw
*.img

# Third-party binaries and archives.
# Fetch them with scripts/download-assets.sh; never commit them.
*.exe
*.msi
*.msixbundle
*.zip
*.7z
*.dll
*.pdb
*.cat
*.inf
*.pem
*.crt

# Third-party source trees fetched by download-assets.sh
drivers/
apps/winget/

# Runtime logs, screenshots and local scratch space
logs/
images/
isos/
.build/
.debug/
/vm-tests/win11-visibility-test/
__pycache__/
*.pyc

# Local secrets and identity material (keep real files under secrets/)
secrets/
.env*
*.local

# OS / editor junk is best handled by the user's global gitignore
