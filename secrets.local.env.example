# Copy this file to secrets.local.env and fill in the values.
# It is loaded by build-iso.sh and is never committed.

# Strong password for the local Windows administrator account (vmadmin).
ADMIN_PASSWORD=replace-with-a-strong-password

# Optional: path to the SSH public key used for passwordless login.
# Defaults to admin_ed25519.pub in the repository root.
# SSH_PUB_KEY=admin_ed25519.pub
